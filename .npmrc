# Block package versions published in the last 7 days (supply-chain hardening).
# Applies to npm install / npm update — not npm ci (lockfile is installed verbatim).
min-release-age=7
# Security override (package.json overrides) — allow nanoid@3.3.18 before cooldown elapses.
min-release-age-exclude[]=nanoid

audit=true
fund=false
